---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  listIssueHtmlFiles,
  loadIssueManifest,
  loadIssuePage,
} from "../../lib/issues.js";
import { issueBodyClass } from "../../lib/issue-html.js";

export function getStaticPaths() {
  return listIssueHtmlFiles().map((filename) => ({
    params: { name: filename.replace(/\.html$/i, "") },
    props: { filename },
  }));
}

const { filename } = Astro.props;
const issue = loadIssuePage(filename) || {
  title: filename,
  description: "",
  bodyStyle: "",
  bodyClass: "",
  scopedCss: "",
  content: "<p>This issue could not be read.</p>",
};

// Cloudflare 307s /issues/<name>.html to the extensionless form, so the
// .html URL is not the one that serves 200. Point the canonical at the
// same URL the sitemap advertises rather than at a redirect.
//
// latest.html is a byte copy of the newest dated issue, so /issues/latest
// and /issues/<newest date> render the same page. Canonicalise the copy to
// the dated original: a self-canonical asks Google to index one issue at
// two URLs, and /issues/latest changes meaning every week, so it is the
// wrong URL to accumulate ranking signal.
const newest = loadIssueManifest()[0];
const canonicalPath =
  filename.toLowerCase() === "latest.html" && newest
    ? `/issues/${newest.file.replace(/\.html$/i, "")}`
    : `/issues/${filename.replace(/\.html$/, "")}`;
const bodyClass = issueBodyClass(issue.bodyClass);
---

<BaseLayout
  title={issue.title}
  description={issue.description}
  canonicalPath={canonicalPath}
>
  <main class="issue-page">
    <div class="issue-shell">
      <article class={bodyClass} id="page-title" style={issue.bodyStyle || undefined}>
        {issue.scopedCss ? <style is:inline set:html={issue.scopedCss} /> : null}
        <Fragment set:html={issue.content} />
      </article>
    </div>
  </main>
</BaseLayout>

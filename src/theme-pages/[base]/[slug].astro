---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import SubscribeBlock from "../../components/SubscribeBlock.astro";
import { getMarket, guidePath, siteUrl } from "../../lib/market.js";
import { formatDate, placeLabel, venueHeadings } from "../../lib/guides.js";

export async function getStaticPaths() {
  const market = getMarket();
  const guides = await getCollection("guides");
  return guides.map((entry) => ({
    params: { base: market.guidesBasePath, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const market = getMarket();
const all = await getCollection("guides");
const { Content } = await render(entry);
const path = guidePath(market, entry.data.slug);
const origin = siteUrl(market);
const verified = formatDate(entry.data.last_verified);
const generated = formatDate(entry.data.generated);
const venues = venueHeadings(entry.body);
const place = placeLabel(entry.data.place);

const heroSrc = entry.data.hero_image
  ? `${path}/${entry.data.hero_image}`.replace(/\/+/g, "/")
  : undefined;
const socialSrc = entry.data.social_image
  ? `${path}/${entry.data.social_image}`.replace(/\/+/g, "/")
  : heroSrc;

const itemList =
  venues.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: entry.data.title,
        description: entry.data.description,
        numberOfItems: venues.length,
        itemListElement: venues.map((name, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name,
        })),
      }
    : null;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  url: `${origin}${path}`,
  isAccessibleForFree: true,
  publisher: { "@type": "Organization", name: market.name },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={path}
  ogType="article"
  ogImage={socialSrc}
  jsonLd={[articleLd, itemList].filter(Boolean)}
>
  <article class="guide-wrap wrap">
    <p class="eyebrow">{market.name}</p>
    <h1>{entry.data.title}</h1>
    <p class="dek">{entry.data.intro}</p>
    <p class="guide-meta">
      {place && <span>{place}</span>}
      {entry.data.entry_count ? <span> · {entry.data.entry_count} listings</span> : null}
      {verified ? <span> · Last verified {verified}</span> : null}
    </p>
    {
      heroSrc && (
        <img
          class="guide-hero-image"
          src={heroSrc}
          alt={entry.data.hero_image_alt || entry.data.title}
        />
      )
    }
    <div class="guide-body">
      <Content />
    </div>
    <p class="guide-meta">
      Compiled from each organisation's own public calendar. Details change — confirm
      before you go.
      {generated ? ` Last updated: ${generated}.` : ""}
      {verified ? ` Last verified: ${verified}.` : ""}
      {" "}From {market.name}.
    </p>
    <RelatedGuides current={entry} all={all} />
    <div class="tile">
      <SubscribeBlock variant="light" />
    </div>
  </article>
</BaseLayout>

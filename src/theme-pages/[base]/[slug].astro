---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedGuides from "../../components/RelatedGuides.astro";
import SubscribeBlock from "../../components/SubscribeBlock.astro";
import { getMarket, guidePath, siteUrl } from "../../lib/market.js";
import {
  formatDate,
  guideListings,
  placeLabel,
  publicImageDimensions,
} from "../../lib/guides.js";

export async function getStaticPaths() {
  const market = getMarket();
  const guides = await getCollection("guides");
  return guides.map((entry) => ({
    params: { base: market.guidesBasePath, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const market = getMarket();
const all = await getCollection("guides");
const { Content } = await render(entry);
const path = guidePath(market, entry.data.slug);
const origin = siteUrl(market);
const verified = formatDate(entry.data.last_verified || entry.data.verified_on);
const generated = formatDate(entry.data.generated);
const listings = guideListings(entry.body);
const place = placeLabel(entry.data.place);

const heroSrc = entry.data.hero_image
  ? `${path}/${entry.data.hero_image}`.replace(/\/+/g, "/")
  : undefined;
const socialSrc = entry.data.social_image
  ? `${path}/${entry.data.social_image}`.replace(/\/+/g, "/")
  : heroSrc;
const heroDimensions = publicImageDimensions(
  heroSrc,
  entry.data.hero_image_width,
  entry.data.hero_image_height
);
const socialDimensions =
  socialSrc === heroSrc ? heroDimensions : publicImageDimensions(socialSrc);

const itemList =
  listings.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "@id": `${origin}${path}#itemlist`,
        name: entry.data.title,
        description: entry.data.description,
        numberOfItems: listings.length,
        itemListElement: listings.map((listing, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            name: listing.name,
            ...(listing.venue
              ? {
                  location: {
                    "@type": "Place",
                    name: listing.venue,
                  },
                }
              : {}),
          },
        })),
      }
    : null;

const heroImageAlt = entry.data.hero_image_alt?.trim();
const heroImageText =
  heroImageAlt && heroImageAlt !== entry.data.title ? heroImageAlt : "";
const heroImageLd = heroSrc
  ? {
      "@type": "ImageObject",
      url: `${origin}${heroSrc}`,
      ...(heroDimensions
        ? { width: heroDimensions.width, height: heroDimensions.height }
        : {}),
      ...(heroImageText
        ? {
            caption: heroImageText,
            description: heroImageText,
          }
        : {}),
    }
  : null;

// Guides are curated roundup pages, not reviews or event listings; CollectionPage
// plus ItemList mirrors the visible venue/program headings without inventing ratings.
const guidePageLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${origin}${path}#webpage`,
  url: `${origin}${path}`,
  name: entry.data.title,
  description: entry.data.description,
  inLanguage: "en",
  isAccessibleForFree: true,
  publisher: { "@id": `${origin}/#organization` },
  isPartOf: { "@id": `${origin}/#website` },
  about: {
    "@type": "Thing",
    name: entry.data.title,
  },
  spatialCoverage: {
    "@type": "Place",
    name: place || market.regionLabel,
  },
  ...(verified ? { dateModified: verified } : {}),
  ...(heroImageLd ? { primaryImageOfPage: heroImageLd, image: heroImageLd } : {}),
  ...(itemList ? { mainEntity: { "@id": `${origin}${path}#itemlist` } } : {}),
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={path}
  ogType="article"
  ogImage={socialSrc}
  ogImageWidth={socialDimensions?.width}
  ogImageHeight={socialDimensions?.height}
  jsonLd={[guidePageLd, itemList].filter(Boolean)}
>
  <article class="guide-wrap wrap">
    <p class="eyebrow">{market.name}</p>
    <h1>{entry.data.title}</h1>
    <p class="dek">{entry.data.intro}</p>
    <p class="guide-meta">
      {place && <span>{place}</span>}
      {entry.data.entry_count ? <span> · {entry.data.entry_count} listings</span> : null}
      {verified ? <span> · Listings checked on {verified}</span> : null}
    </p>
    {
      heroSrc && (
        <img
          class="guide-hero-image"
          src={heroSrc}
          alt={entry.data.hero_image_alt || entry.data.title}
          width={heroDimensions?.width}
          height={heroDimensions?.height}
        />
      )
    }
    <div class="guide-body" data-guide-gate>
      <Content />
    </div>
    <aside class="guide-gate-cta" data-guide-gate-cta hidden>
      <h2>Keep reading — it's free.</h2>
      <p>
        The rest of this guide is yours when you join {market.name}. One short
        email a week, and you can unsubscribe in one click.
      </p>
      <p>
        <a class="button" href="/subscribe">Subscribe and keep reading</a>
      </p>
      <p class="guide-gate-note">
        Already subscribed? <a href="?subscribed=1">Show me the whole guide.</a>
        The signup form at the foot of this page unlocks it too.
      </p>
    </aside>
    <p class="guide-meta">
      Compiled from each organisation's own public calendar. Details change — confirm
      before you go.
      {generated ? ` Last updated: ${generated}.` : ""}
      {verified ? ` Last verified: ${verified}.` : ""}
      {" "}From {market.name}.
    </p>
    <RelatedGuides current={entry} all={all} />
    <div class="tile">
      <SubscribeBlock variant="light" />
    </div>
  </article>

<script is:inline>
  // The guide text stays in the document and only its visibility changes.
  // These pages exist to rank, so removing the body server-side would give
  // away the thing the gate is meant to earn from.
  (function () {
    var body = document.querySelector("[data-guide-gate]");
    var cta = document.querySelector("[data-guide-gate-cta]");
    if (!body || !cta) return;
    var KEY = "guide_unlocked";

    function unlock(remember) {
      body.classList.add("is-unlocked");
      cta.hidden = true;
      if (remember) {
        try { localStorage.setItem(KEY, "1"); } catch (e) {}
      }
    }

    var already = false;
    try { already = localStorage.getItem(KEY) === "1"; } catch (e) {}
    var param = new URLSearchParams(window.location.search).get("subscribed");
    var fromSignup = param !== null && param !== "0";

    if (already) {
      unlock(false);
      return;
    }
    if (fromSignup) {
      unlock(true);
      try { history.replaceState(null, "", window.location.pathname); } catch (e) {}
      return;
    }

    // Locked: hide the tail, show the ask.
    body.classList.add("is-gated");
    cta.hidden = false;

    // Kit replaces the form with its success message in place rather than
    // navigating, so a redirect is not the only way through.
    document.addEventListener("submit", function (event) {
      if (!event.target.classList.contains("formkit-form")) return;
      setTimeout(function () { unlock(true); }, 1200);
    }, true);
  })();
</script>
</BaseLayout>

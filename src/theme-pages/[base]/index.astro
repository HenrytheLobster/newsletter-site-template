---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMarket, guidesIndexPath } from "../../lib/market.js";
import { toCard } from "../../lib/guides.js";
import { guideHeroImage } from "../../lib/home.js";

export function getStaticPaths() {
  const market = getMarket();
  return [{ params: { base: market.guidesBasePath } }];
}

const market = getMarket();
const guides = (await getCollection("guides")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
const cards = guides.map((g) => ({
  ...toCard(market, g),
  image: guideHeroImage(market, g.data.slug, g.data.hero_image),
}));
const path = guidesIndexPath(market);
---

<BaseLayout
  title={`Guides — ${market.name}`}
  description={`Local roundups and guides from ${market.name}.`}
  canonicalPath={path}
>
  <div class="wrap guides-index">
    <p class="eyebrow">{market.regionLabel}</p>
    <h1>Guides</h1>
    <p class="dek">
      Local roundups compiled from official calendars. Each listing links back to
      the source so you can confirm before you go.
    </p>

    {
      market.featuredLegacy.length > 0 && (
        <section class="guide-category" aria-labelledby="featured-guides-heading">
          <h2 class="section-heading" id="featured-guides-heading">Featured</h2>
          <div class="tiles" aria-label="Featured guides">
            {market.featuredLegacy.map((item) => (
              <article class="tile">
                {item.image && <img src={item.image} alt="" width="400" height="220" />}
                <strong>{item.title}</strong>
                <p>{item.description}</p>
                <a class="button" href={item.href}>Open the guide</a>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="guide-category" aria-labelledby="all-roundups-heading">
      <h2 class="section-heading" id="all-roundups-heading">All roundups</h2>
      {
        cards.length === 0 ? (
          <p>No roundup guides in this market yet.</p>
        ) : (
          <div class="tiles tiles-2" aria-label="Roundup guides">
            {cards.map((card) => (
              <article class="tile">
                {card.image && <img src={card.image} alt="" width="400" height="220" />}
                <strong>{card.title}</strong>
                <p>{card.description}</p>
                {card.place && (
                  <p class="guide-meta">
                    {card.place}
                    {card.entryCount ? ` · ${card.entryCount} listings` : ""}
                  </p>
                )}
                <p>
                  <a class="button" href={card.href}>Read the guide</a>
                </p>
              </article>
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
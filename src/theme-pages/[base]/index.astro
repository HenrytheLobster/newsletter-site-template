---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMarket, guidesIndexPath } from "../../lib/market.js";
import { toCard } from "../../lib/guides.js";
import { guideHeroImage } from "../../lib/home.js";

export function getStaticPaths() {
  const market = getMarket();
  return [{ params: { base: market.guidesBasePath } }];
}

const market = getMarket();
const guides = (await getCollection("guides")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
const cards = guides.map((g) => ({
  ...toCard(market, g),
  image: guideHeroImage(market, g.data.slug, g.data.hero_image),
}));
const path = guidesIndexPath(market);
---

<BaseLayout
  title={`Articles — ${market.name}`}
  description={`Local writing from ${market.name} — where to go, what it costs, when to turn up.`}
  canonicalPath={path}
>
  <div class="wrap guides-index">
    <p class="eyebrow">{market.regionLabel}</p>
    <h1>Articles</h1>
    <p class="dek">
      Where to go and when to turn up, written up one subject at a time.
    </p>

    {
      market.featuredLegacy.length > 0 && (
        <section class="guide-category" aria-labelledby="featured-guides-heading">
          {/* The lead magnets. These are the only things on the site that are
              genuinely guides, and they keep both the name and /guides/. */}
          <h2 class="section-heading" id="featured-guides-heading">Free guides</h2>
          <div class="tiles" aria-label="Free guides">
            {market.featuredLegacy.map((item) => (
              <article class="tile">
                {item.image && <img src={item.image} alt="" width="400" height="220" />}
                <strong>{item.title}</strong>
                <p>{item.description}</p>
                <a class="button" href={item.href}>Open the guide</a>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="guide-category" aria-labelledby="all-articles-heading">
      <h2 class="section-heading" id="all-articles-heading">All articles</h2>
      {
        cards.length === 0 ? (
          <p>No articles in this market yet.</p>
        ) : (
          <div class="tiles tiles-2" aria-label="Articles">
            {cards.map((card) => (
              <article class="tile">
                {card.image && <img src={card.image} alt="" width="400" height="220" />}
                <strong>{card.title}</strong>
                <p>{card.description}</p>
                {card.place && (
                  <p class="guide-meta">
                    {card.place}
                    {card.entryCount ? ` · ${card.entryCount} listings` : ""}
                  </p>
                )}
                <p>
                  <a class="button" href={card.href} aria-label={`Read: ${card.title}`}>
                    Read more
                  </a>
                </p>
              </article>
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
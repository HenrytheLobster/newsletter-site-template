---
import { getMarket, guidesIndexPath } from "../lib/market.js";
import { leadMagnetGuides } from "../lib/guides.js";
import { getDesignId } from "../lib/design.js";

const market = getMarket();
const design = getDesignId();
const guidesHref = guidesIndexPath(market);
const { current = "" } = Astro.props;
const logo = market.logo || null;
const hasLeadMagnets = leadMagnetGuides(market).length > 0;

const links = [
  { href: "/", label: market.nav.home },
  { href: "/issues/latest.html", label: market.nav.issue },
  { href: guidesHref, label: market.nav.guides },
  // Only where there is a lead magnet index to point at.
  ...(hasLeadMagnets ? [{ href: "/guides/", label: "Guides" }] : []),
  { href: "/issues/", label: market.nav.archive },
  { href: "/subscribe", label: market.nav.subscribe },
];

function isCurrent(href: string) {
  if (href === "/") return current === "/";
  if (current === href) return true;
  if (href === "/issues/") {
    if (current === "/issues" || current === "/issues/") return true;
    return (
      current.startsWith("/issues/") &&
      current.endsWith(".html") &&
      !current.endsWith("/latest.html")
    );
  }
  const guidesBase = guidesHref.replace(/\/$/, "");
  if (href === guidesBase && (current === guidesBase || current.startsWith(guidesBase + "/"))) {
    return true;
  }
  return false;
}
---

{
  design === "a" && (
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="brand" href="/">
          {logo && <img class="brand-logo" src={logo.src} alt="" width={logo.width || 64} height={logo.height || 64} />}
          <span>{market.name}</span>
        </a>
        <nav aria-label="Primary">
          {links.map((link) => (
            <a
              href={link.href}
              class={link.href === "/subscribe" ? "nav-subscribe" : undefined}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
  )
}

{
  design === "b" && (
    <header class="masthead">
      <div class="masthead-bar">
        <div class="wrap masthead-brand">
          <a class="brand" href="/">
            {logo && <img class="brand-logo" src={logo.src} alt="" width={logo.width || 64} height={logo.height || 64} />}
            <span>{market.name}</span>
          </a>
          <p class="masthead-region">{market.home.eyebrow}</p>
        </div>
      </div>
      <nav class="masthead-nav" aria-label="Primary">
        <div class="wrap">
          {links.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    </header>
  )
}

{
  design === "c" && (
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="brand" href="/">
          {logo && <img class="brand-logo" src={logo.src} alt="" width={logo.width || 64} height={logo.height || 64} />}
          <span>{market.name}</span>
        </a>
        <nav aria-label="Primary">
          {links.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
  )
}
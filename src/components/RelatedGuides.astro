---
import { getMarket, guidePath } from "../lib/market.js";
import { relatedGuides, placeLabel } from "../lib/guides.js";

const { current, all } = Astro.props;
const market = getMarket();
const items = relatedGuides(current, all, 4);
---

{
  items.length > 0 && (
    <aside class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">You may also like</h2>
      <ul class="related-list">
        {items.map((entry) => (
          <li>
            <a href={guidePath(market, entry.data.slug)}>
              <strong>{entry.data.title}</strong>
              <span>{placeLabel(entry.data.place)}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
